#!/data/data/com.termux/files/usr/bin/bash
# Termux Android Studio-like menu (project aware)
[ -f ~/.android-env ] && source ~/.android-env
[ -f ~/.bashrc ] && source ~/.bashrc >/dev/null 2>&1
SDK=$ANDROID_HOME
NDK=$ANDROID_NDK_HOME

is_project() { [ -f "$PWD/settings.gradle" ] && [ -d "$PWD/app" ]; }

find_apk() { find "$PWD/app/build/outputs/apk" -name '*.apk' 2>/dev/null; }

create_project() {
  read -p "Project ka naam: " name
  read -p "Package id (ex: com.example.myapp): " pkg
  dest=~/"$name"
  [ -d "$dest" ] && { echo "Pehle se hai: $dest"; return; }
  cp -r ~/demo-app "$dest"
  rm -rf "$dest/build" "$dest/app/build" "$dest/.gradle" "$dest/gradle.bat"
  cd "$dest"
  grep -rl "com.example.demo" app/build.gradle app/src/main/AndroidManifest.xml app/src/main/java settings.gradle | xargs sed -i "s/com.example.demo/$pkg/g"
  mkdir -p "app/src/main/java/$(echo $pkg | tr . /)"
  mv "app/src/main/java/com/example/demo/MainActivity.java" "app/src/main/java/$(echo $pkg | tr . /)/"
  rm -rf app/src/main/java/com
  cat > local.properties <<LP
sdk.dir=$SDK
ndk.dir=$NDK
cmake.dir=$SDK/cmake
LP
  cd "$dest"
  echo "Ban gaya: $dest (cd $name karke wapas termux-studio chalao)"
}

project_info() {
  echo "--- Project: $PWD"
  grep -E "applicationId|compileSdk|targetSdk|minSdk|ndkVersion" app/build.gradle | head -6
  echo "Java: $(java -version 2>&1 | head -1)"
  find_apk | sed 's/^/APK: /'
}

while true; do
  clear 2>/dev/null || true
  echo "========================================="
  if is_project; then
    echo " PROJECT MODE: $PWD"
    echo "========================================="
    echo " 1) Build Debug APK"
    echo " 2) Build Release APK"
    echo " 3) Rebuild (clean + debug)"
    echo " 4) Clean project"
    echo " 5) APK output kahaan se milega"
    echo " 6) APK install karo (adb)"
    echo " 7) App open karo (adb start)"
    echo " 8) APK SD card me copy karo"
    echo " 9) Project info / versions"
    echo "10) Wapas home (project se bahar)"
  else
    echo " TERMUX STUDIO (home)"
    echo "========================================="
    echo " 1) Naya project create karo"
    echo " 2) Project list dikhaun + kholo"
    echo " 3) Project me jaane ke liye cd karke fir termux-studio chalao"
  fi
  echo " 0) Exit"
  echo "========================================="
  read -p "Option: " opt
  if is_project; then
    case $opt in
      1) ./gradlew assembleDebug ;;
      2) ./gradlew assembleRelease ;;
      3) ./gradlew clean assembleDebug ;;
      4) ./gradlew clean ;;
      5) find_apk ;;
      6) apk=$(find_apk | head -1); [ -z "$apk" ] && echo "Pehle build karo" || adb install -r "$apk" ;;
      7) pkg=$(grep applicationId app/build.gradle | sed "s/.*'\(.*\)'/\1/"); adb shell monkey -p "$pkg" -c android.intent.category.LAUNCHER 1 ;;
      8) apk=$(find_apk | head -1); [ -z "$apk" ] && echo "Pehle build karo" || { cp "$apk" /sdcard/; echo "/sdcard/$(basename $apk)"; } ;;
      9) project_info ;;
      10) cd ~ ;;
      0) exit 0 ;;
      *) echo "Galat option" ;;
    esac
  else
    case $opt in
      1) create_project ;;
      2) ls -d ~/*/ | while read d; do [ -f "$d/settings.gradle" ] && echo "  $d"; done ;;
      3) echo "cd ~/project-naam && termux-studio" ;;
      0) exit 0 ;;
      *) echo "Galat option" ;;
    esac
  fi
  read -p "Enter dabana..." _
done
